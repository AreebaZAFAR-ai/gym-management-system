{
  "compilerOptions": {
    "target": "ES2023",
    "module": "node20",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "sourceMap": true,
    "rootDir": "..",
    "outDir": "dist",
    "paths": {
      "@gym/shared": ["../shared/src"]
    }
  },
  "include": ["src", "test", "drizzle.config.ts", "vitest.config.ts"],
  "exclude": ["test/contract.e2e.test.ts", "test/admin-contract.e2e.test.ts"]
}
