# Copy to api/.env and fill in. api/.env is git-ignored; never commit it.

NODE_ENV=development
PORT=3000

# Neon console > your project > Dashboard > Connect.
# Pooled connection ("Connection pooling" ON, host contains -pooler). Used by the API.
DATABASE_URL=postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<database>?sslmode=require&channel_binding=require

# Direct connection ("Connection pooling" OFF, same host without -pooler). Used only by migrations.
DATABASE_URL_DIRECT=postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/<database>?sslmode=require&channel_binding=require

# Signs login tokens (60-day expiry). At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Comma-separated browser origins allowed to call the API (the web admin). Required in production.
CORS_ORIGINS=http://localhost:3001

# Optional. Folder for uploaded payment screenshots (local disk, development). Default: ./uploads (git-ignored).
# UPLOAD_DIR=

# Spec §8: S3-compatible storage (AWS S3, Cloudflare R2). Required in production; when
# S3_BUCKET is set, screenshots are stored in the bucket instead of UPLOAD_DIR.
# Keep the bucket private: the API serves screenshots only through 15-minute signed links.
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
