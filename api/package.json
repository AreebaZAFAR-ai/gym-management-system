{
  "name": "@gym/api",
  "version": "1.0.0",
  "private": true,
  "description": "Gym management API (NestJS, Drizzle, PostgreSQL)",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node dist/api/src/main.js",
    "dev": "npm run build && npm run start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:check": "node scripts/db-check.mjs",
    "device:demo": "node scripts/demo-fingerprint-device.mjs",
    "db:verify": "node scripts/db-verify.mjs",
    "gym:create": "npm run build && node dist/api/src/cli/create-gym.js",
    "gym:demo": "npm run build && node dist/api/src/cli/create-gym.js --demo",
    "db:generate": "drizzle-kit generate",
    "db:status": "npm run build --silent && node dist/api/src/cli/db.js status",
    "db:backup": "npm run build --silent && node dist/api/src/cli/db.js backup",
    "db:migrate": "npm run build --silent && node dist/api/src/cli/db.js migrate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1178.0",
    "@gym/shared": "1.0.0",
    "@nestjs/common": "^11.2.11",
    "@nestjs/core": "^11.2.11",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.11",
    "@noble/hashes": "^2.0.1",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "@nestjs/testing": "^11.2.11",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "supertest": "^7.3.2",
    "tsc-alias": "^1.9.10",
    "typescript": "~6.0.3",
    "vitest": "^3.2.4"
  }
}
